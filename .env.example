# Salin ke .env.local (jangan di-commit). Semua nilai di bawah hanya contoh.
DATABASE_URL=postgresql://comprospero:GANTI_SANDI@localhost:5432/compro_spero
# DATABASE_SSL=true            # untuk Postgres terkelola (Supabase/Neon/RDS) yang mewajibkan SSL
APIFY_TOKEN=                    # token Apify untuk sinkron Instagram
INSTAGRAM_USERNAME=spero_id
INSTAGRAM_LIMIT=12
INSTAGRAM_SKIP_VIDEO=false
SESSION_SECRET=                 # dibuat otomatis saat pertama kali login admin; JANGAN diganti tanpa perlu (mencabut semua sesi)
COOKIE_SECURE=false             # true bila situs dilayani lewat HTTPS (wajib di produksi)
HOST=127.0.0.1
PORT=8078
